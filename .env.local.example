# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: used by seed scripts / admin operations. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email reminders). Get a key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL="TDS Tracker <notifications@yourdomain.com>"

# Used to build absolute links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron endpoint auth (Vercel Cron -> /api/cron/reminders)
CRON_SECRET=
